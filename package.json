{
  "name": "blog_temp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:images": "python scripts/lint_image_references.py",
    "lint:purity": "python scripts/lint_multilingual_purity.py",
    "gate": "blog-gatekeeper --dir src/content/docs --platform gear",
    "gate:self": "blog-gatekeeper --self-test",
    "audit:engineering": "python scripts/lint_multilingual_purity.py && python scripts/audit_engineering_truth.py",
    "audit:symmetry": "python scripts/lint_multilingual_symmetry.py",
    "audit:terms": "python scripts/lint_engineering_terms.py",
    "audit:math": "python scripts/verify_engineering_math.py",
    "audit:code": "python scripts/audit_embedded_code.py",
    "audit:canonical": "python scripts/audit_canonical_equations.py",
    "audit:peer-review": "python scripts/adversarial_engineering_reviewer.py",
    "audit:visual": "python scripts/visual_qa_gate.py",
    "lint:visual": "python scripts/visual_qa_gate.py",
    "audit:all": "npm run gate && npm run lint:images && npm run lint:purity && npm run audit:code && npm run audit:canonical && npm run audit:peer-review && npm run audit:engineering && npm run audit:visual",
    "test": "pytest tests/test_engineering_auditors.py tests/test_embedded_code_auditor.py tests/test_canonical_math_auditor.py tests/test_adversarial_peer_reviewer.py tests/test_reservation_system.py tests/test_code1_pipeline.py tests/test_series2_ch04_engineering.py tests/test_series2_ch05_engineering.py tests/test_multilingual_purity.py tests/test_visual_qa_gate.py",
    "test:auditors": "pytest tests/test_engineering_auditors.py",
    "test:canonical": "pytest tests/test_canonical_math_auditor.py",
    "test:peer-review": "pytest tests/test_adversarial_peer_reviewer.py",
    "test:visual": "pytest tests/test_visual_qa_gate.py",
    "test:code": "pytest tests/test_embedded_code_auditor.py",
    "test:purity": "pytest tests/test_multilingual_purity.py",
    "db:sync": "python scripts/sync_posts_db.py",
    "db:summary": "python scripts/manage_posts_db.py --summary",
    "db:list": "python scripts/manage_posts_db.py --list",
    "db:verify": "python scripts/manage_posts_db.py --verify",
    "db:prune": "python scripts/manage_posts_db.py --prune",
    "db:next": "python scripts/manage_posts_db.py --next",
    "db:transition": "python scripts/manage_posts_db.py --transition",
    "db:timeline": "python scripts/manage_posts_db.py --timeline",
    "db:catalog": "python scripts/manage_posts_db.py --catalog",
    "test:reservation": "pytest tests/test_reservation_system.py",
    "code1": "python scripts/code1_ingestion_pipeline.py",
    "test:code1": "pytest tests/test_code1_pipeline.py",
    "publish:edge": "python publish_to_edge.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.3.6",
    "katex": "^0.19.1",
    "photoswipe": "^5.4.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  }
}
