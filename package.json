{
  "name": "blog_temp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:images": "python scripts/lint_image_references.py",
    "gate": "blog-gatekeeper --dir src/content/docs --platform gear",
    "gate:self": "blog-gatekeeper --self-test",
    "db:sync": "python scripts/sync_posts_db.py",
    "db:summary": "python scripts/manage_posts_db.py --summary",
    "db:list": "python scripts/manage_posts_db.py --list",
    "db:verify": "python scripts/manage_posts_db.py --verify",
    "db:prune": "python scripts/manage_posts_db.py --prune",
    "db:next": "python scripts/manage_posts_db.py --next",
    "db:transition": "python scripts/manage_posts_db.py --transition",
    "db:timeline": "python scripts/manage_posts_db.py --timeline",
    "db:catalog": "python scripts/manage_posts_db.py --catalog",
    "test:reservation": "pytest tests/test_reservation_system.py",
    "publish:edge": "python publish_to_edge.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.3.6",
    "katex": "^0.19.1",
    "photoswipe": "^5.4.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3"
  }
}
