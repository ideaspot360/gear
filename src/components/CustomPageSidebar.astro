---
// src/components/CustomPageSidebar.astro
import type { Props } from '@astrojs/starlight/props';
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';

const starlightRoute = Astro.locals?.starlightRoute || (Astro.props as any);
const tocItems = starlightRoute?.toc?.items || [];
const hasToc = Boolean(starlightRoute?.toc && tocItems.length > 0);
const locale = Astro.props.locale || starlightRoute?.locale || 'ko';

const toolsI18n = {
  ko: {
    title: '⚡️ H-GEAR Studio 빠른 연동',
    sim: '📐 치형 기하학 실시간 시뮬레이터',
    export: '📥 ISO 6336 계산서 내보내기',
    cad: '⚙️ 3D B-Rep CAD STEP 검증기',
  },
  en: {
    title: '⚡️ H-GEAR Studio Quick Tools',
    sim: '📐 Flank Geometry Live Simulator',
    export: '📥 Export ISO 6336 Calculation Sheet',
    cad: '⚙️ 3D B-Rep CAD STEP Inspector',
  },
  de: {
    title: '⚡️ H-GEAR Studio Schnellzugriff',
    sim: '📐 Zahnflankengeometrie-Live-Simulator',
    export: '📥 ISO 6336 Berechnungsblatt exportieren',
    cad: '⚙️ 3D-B-Rep-CAD-STEP-Prüfer',
  },
  ja: {
    title: '⚡️ H-GEAR Studio クイックツール',
    sim: '📐 歯形幾何学リアルタイムシミュレータ',
    export: '📥 ISO 6336 計算書エクスポート',
    cad: '⚙️ 3D B-Rep CAD STEP 検証機',
  },
}[locale] || {
  title: '⚡️ H-GEAR Studio Quick Tools',
  sim: '📐 Flank Geometry Live Simulator',
  export: '📥 Export ISO 6336 Calculation Sheet',
  cad: '⚙️ 3D B-Rep CAD STEP Inspector',
};
---

{hasToc && (
  <div class="custom-page-sidebar-wrapper">
    <!-- 모바일 On-This-Page 토글 (모바일 뷰포트) -->
    <div class="lg:sl-hidden">
      <MobileTableOfContents {...Astro.props} />
    </div>

    <!-- 데스크톱 우측 사이드바 패널 -->
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container custom-page-sidebar">
        <!-- 1. 읽기 진행률 인디케이터 바 -->
        <div class="reading-progress-container">
          <div class="progress-label">
            <span>Reading Progress</span>
            <span id="reading-percent">0%</span>
          </div>
          <div class="reading-progress-track">
            <div id="reading-progress-bar" class="reading-progress-fill"></div>
          </div>
        </div>

        <!-- 2. 기본 Starlight On-This-Page Table of Contents -->
        <TableOfContents {...Astro.props} />

        <!-- 3. H-GEAR STUDIO 엔지니어링 퀵 툴즈 박스 -->
        <div class="quick-tools-box">
          <div class="quick-tools-title">{toolsI18n.title}</div>
          <a href="https://gear.ideaspot360.com" target="_blank" rel="noopener">{toolsI18n.sim}</a>
          <a href="https://gear.ideaspot360.com" target="_blank" rel="noopener">{toolsI18n.export}</a>
          <a href="https://gear.ideaspot360.com" target="_blank" rel="noopener">{toolsI18n.cad}</a>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  function updateProgress() {
    const bar = document.getElementById('reading-progress-bar');
    const label = document.getElementById('reading-percent');
    if (!bar || !label) return;

    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (scrollHeight <= 0) {
      bar.style.width = '0%';
      label.textContent = '0%';
      return;
    }

    const progress = Math.min(100, Math.max(0, Math.round((scrollTop / scrollHeight) * 100)));
    bar.style.width = `${progress}%`;
    label.textContent = `${progress}%`;
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateProgress);
  } else {
    updateProgress();
  }
  document.addEventListener('astro:page-load', updateProgress);
</script>

<style>
  .custom-page-sidebar {
    padding: 1.25rem 0.5rem 1.5rem 1.25rem;
    border-left: 1px solid var(--sl-color-hairline);
  }
  .reading-progress-container {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.35rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .reading-progress-track {
    width: 100%;
    height: 4px;
    background: var(--sl-color-hairline);
    border-radius: 2px;
    overflow: hidden;
  }
  .reading-progress-fill {
    height: 100%;
    background: #3b82f6;
    width: 0%;
    transition: width 0.1s ease;
  }

  /* ToC (On-This-Page) 폰트 크기 및 밑줄 해제, 여백 최적화 */
  :global(starlight-toc) {
    display: block;
  }
  :global(starlight-toc h2#starlight__on-this-page) {
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: var(--sl-color-gray-3) !important;
    margin-top: 0 !important;
    margin-bottom: 0.75rem !important;
  }
  :global(starlight-toc ul) {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  :global(starlight-toc li) {
    margin: 0.15rem 0 !important;
    line-height: 1.35 !important;
  }
  :global(starlight-toc a) {
    display: block !important;
    font-size: 0.8125rem !important; /* 좌측 사이드바 트리(0.82rem)와 조화 */
    line-height: 1.4 !important;
    color: var(--sl-color-gray-3) !important;
    text-decoration: none !important; /* 밑줄 제거 */
    padding: 0.25rem 0.4rem !important;
    border-radius: 4px !important;
    transition: all 0.15s ease !important;
  }
  :global(starlight-toc a:hover) {
    color: var(--sl-color-white) !important;
    background: rgba(255, 255, 255, 0.05) !important;
    text-decoration: none !important;
  }
  :global([data-theme='light'] starlight-toc a:hover) {
    color: #0f172a !important;
    background: rgba(0, 0, 0, 0.04) !important;
  }
  :global(starlight-toc a[aria-current='true']) {
    color: #3b82f6 !important;
    font-weight: 600 !important;
    background: rgba(59, 130, 246, 0.08) !important;
    text-decoration: none !important;
  }
  :global([data-theme='light'] starlight-toc a[aria-current='true']) {
    color: #2563eb !important;
    background: rgba(37, 99, 235, 0.08) !important;
  }
  :global(starlight-toc ul ul) {
    padding-left: 0.75rem !important;
    border-left: 1px solid var(--sl-color-hairline) !important;
    margin: 0.2rem 0 0.2rem 0.35rem !important;
  }

  .quick-tools-box {
    margin-top: 1.5rem;
    padding: 0.85rem;
    background: rgba(59, 130, 246, 0.05);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 8px;
    font-size: 0.8rem;
  }
  .quick-tools-title {
    font-weight: 700;
    color: var(--sl-color-white);
    margin-bottom: 0.5rem;
  }
  .quick-tools-box a {
    display: block;
    margin-top: 0.35rem;
    color: #60a5fa;
    text-decoration: none;
    font-size: 0.78rem;
    transition: color 0.15s ease;
  }
  .quick-tools-box a:hover {
    color: #93c5fd;
    text-decoration: underline;
  }
</style>
